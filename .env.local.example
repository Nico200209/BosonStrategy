# ── Bosón Ingeniería Estratégica de Negocios ─────────────────────────
# Renombrar este archivo a .env.local y completar los valores reales.
# NUNCA subir .env.local al repositorio.

# ── EmailJS (formulario de contacto) ─────────────────────────────────
# Obtener en: https://dashboard.emailjs.com
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx

# ── MailerLite (newsletter) ───────────────────────────────────────────
# Obtener de: Dashboard → Forms → tu formulario → embed code → action URL
NEXT_PUBLIC_MAILERLITE_FORM_URL=https://assets.mailerlite.com/jsonp/XXXXXX/forms/XXXXXX/subscribe
